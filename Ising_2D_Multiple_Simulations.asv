T = linspace(1,4,21);
Et = zeros(length(T),1);
Mt = zeros(length(T),1);
Ct = zeros(length(T),1);
Chit = zeros(length(T),1);
i = 1;
k = 1;

for t=T
    [E, M] = Ising_2D_Func(t, 30);
    Et(i) = mean(E);
    Ct(i) = (mean(E.^2) - mean(E)^2)/(k*t^2);
    Mt(i) = mean(M);
    Chit(i) = ();
    i = i + 1;
end
Ct = (mean(ET.^2)-mean(ET)^2)/(k*T.^2);
Chit = (mean(MT.^2)-mean(MT)^2)/(k*T);